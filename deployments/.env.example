# Template for the per-environment env files. Never commit the real ones.
#
#   cp .env.example .env.prod    # used by docker-compose.yml       (production stack)
#   cp .env.example .env.test    # used by docker-compose.test.yml  (test stack)
#
# Give each environment its OWN values — sharing them means a test credential or
# token also works against production.

# SQL Server SA password — min 8 chars incl. upper, lower, digit, symbol.
SA_PASSWORD=Change_This_Str0ng!Passw0rd

# JWT signing key — min 32 bytes, unique per environment. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Host port this stack's web UI listens on.
# Production default 80; use 8080 (or anything free) in .env.test.
WEB_PORT=80
TEST_WEB_PORT=8080
